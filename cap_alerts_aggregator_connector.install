<?php

/**
 * Migrates generic GeoJSON feed sources to the DataQuoll-specific adapter.
 */
function cap_alerts_aggregator_connector_update_9001(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('cap_feed_source');
  $ids = $storage->getQuery()->accessCheck(FALSE)->execute();

  foreach ($storage->loadMultiple($ids) as $source) {
    /** @var \Drupal\cap_alerts_aggregator_connector\Entity\CapFeedSource $source */
    if ($source->get('feed_format') !== 'geojson') {
      continue;
    }
    $source->set('feed_format', 'dataquoll-geojson');
    $source->save();
  }
}

/**
 * Removes park-specific overrides from the portable Feed Source entity.
 */
function cap_alerts_aggregator_connector_update_9002(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('cap_feed_source');
  $ids = $storage->getQuery()->accessCheck(FALSE)->execute();
  foreach ($ids as $id) {
    \Drupal::configFactory()
      ->getEditable('cap_alerts_aggregator_connector.cap_feed_source.' . $id)
      ->clear('park_overrides')
      ->save();
  }
}

/**
 * Prevents uninstall while CAP Feed Source entities remain.
 */
function cap_alerts_aggregator_connector_pre_uninstall(): void {
  $ids = \Drupal::entityTypeManager()
    ->getStorage('cap_feed_source')
    ->getQuery()
    ->accessCheck(FALSE)
    ->execute();
  if ($ids) {
    throw new \RuntimeException('Delete all CAP Feed Source entities before uninstalling CAP Alerts Aggregator Connector.');
  }
}